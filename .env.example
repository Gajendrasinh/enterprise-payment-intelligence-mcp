# Application Settings
APP_NAME=custom-payment-mcp
ENVIRONMENT=local
LOG_LEVEL=INFO

# Security & RBAC Configuration
# Roles: ADMIN, CUSTOMER_SUPPORT, ANALYST, READ_ONLY
DEFAULT_USER_ID=USR-OPERATOR-01
